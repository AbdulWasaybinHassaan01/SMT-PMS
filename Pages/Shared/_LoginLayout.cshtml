<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechWORLD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --tw-bg: #0b1120;
            --tw-card: #151e32;
            --tw-card-border: #26354d;
            --tw-primary: #5252ee;
            --tw-primary-hover: #4343d6;
            --tw-accent: #38bdf8;
            --tw-text-muted: #94a3b8;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--tw-bg);
            background-image: 
                radial-gradient(circle at 20% 20%, rgba(56, 189, 248, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 80% 80%, rgba(99, 102, 241, 0.1) 0%, transparent 40%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #f8fafc;
            padding: 2rem 1rem;
        }

        .auth-container {
            width: 100%;
            max-width: 440px;
        }

        .auth-card {
            background-color: var(--tw-card);
            border: 1px solid var(--tw-card-border);
            border-radius: 20px;
            padding: 2.5rem 2.25rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.05);
        }

        .auth-title {
            font-size: 1.75rem;
            font-weight: 700;
            text-align: center;
            color: #ffffff;
            margin-bottom: 0.35rem;
        }

        .auth-subtitle {
            font-size: 0.9rem;
            color: var(--tw-text-muted);
            text-align: center;
            margin-bottom: 2rem;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .input-label-custom {
            font-size: 0.825rem;
            font-weight: 600;
            color: #cbd5e1;
            margin-bottom: 0.4rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .input-pill-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-pill-icon {
            position: absolute;
            left: 1rem;
            color: #64748b;
            font-size: 1.1rem;
            pointer-events: none;
            z-index: 5;
        }

        .form-control-pill {
            background-color: #f1f5f9;
            color: #0f172a;
            border: 1px solid transparent;
            border-radius: 30px;
            padding: 0.75rem 1rem 0.75rem 2.75rem;
            font-size: 0.925rem;
            font-weight: 500;
            width: 100%;
            transition: all 0.2s ease;
        }

        .form-control-pill:focus {
            background-color: #ffffff;
            color: #0f172a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(82, 82, 238, 0.35);
            border-color: var(--tw-primary);
        }

        .form-control-pill::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

        .input-pill-suffix {
            position: absolute;
            right: 1.1rem;
            color: #64748b;
            font-size: 1.05rem;
            cursor: pointer;
            z-index: 5;
            background: none;
            border: none;
            padding: 0;
        }

        .input-pill-suffix:hover {
            color: #0f172a;
        }

        .btn-auth-primary {
            background: linear-gradient(135deg, #5252ee 0%, #4338ca 100%);
            color: #ffffff;
            border: none;
            border-radius: 30px;
            padding: 0.85rem;
            width: 100%;
            font-size: 1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 10px 20px -5px rgba(82, 82, 238, 0.4);
            transition: all 0.2s ease;
            margin-top: 1.5rem;
        }

        .btn-auth-primary:hover {
            background: linear-gradient(135deg, #4343d6 0%, #3730a3 100%);
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px -5px rgba(82, 82, 238, 0.5);
        }

        .auth-footer-link {
            text-align: center;
            font-size: 0.875rem;
            color: var(--tw-text-muted);
            margin-top: 1.75rem;
        }

        .auth-footer-link a {
            color: #818cf8;
            text-decoration: none;
            font-weight: 600;
        }

        .auth-footer-link a:hover {
            color: #a5b4fc;
            text-decoration: underline;
        }

        .secret-badge {
            background-color: rgba(245, 158, 11, 0.15);
            border: 1px dashed #f59e0b;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            margin-top: 1rem;
            font-size: 0.8rem;
            color: #fde68a;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

