@page
@model TechWorldPMS.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card shadow-sm border-0 p-5 mx-auto" style="max-width: 500px; border-radius: 16px;">
        <div class="mb-3">
            <i class="bi bi-shield-x text-danger" style="font-size: 3.5rem;"></i>
        </div>
        <h2 class="fw-bold text-dark">Access Denied</h2>
        <p class="text-muted mt-2">
            You do not have administrative privileges to access this area. This section is restricted to <strong>Admin & Stock Managers</strong>.
        </p>
        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-page="/Customer/Index" class="btn btn-outline-primary px-4 py-2">
                <i class="bi bi-shop me-1"></i> Customer Store
            </a>
            <a asp-page="/Account/Login" class="btn btn-primary px-4 py-2">
                <i class="bi bi-shield-lock me-1"></i> Log in as Admin
            </a>
        </div>
    </div>
</div>

