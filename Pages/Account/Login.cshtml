@page
@model TechWorldPMS.Pages.Account.LoginModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Sign In";
}

<div class="auth-card">
    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-subtitle">Enter your details to access your account</p>

    @if (!ModelState.IsValid && ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger py-2 px-3 rounded-3 small mb-3 text-start" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            @foreach (var error in ModelState[string.Empty]!.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success py-2 px-3 rounded-3 small mb-3 text-start">
            <i class="bi bi-check-circle-fill me-1"></i> @Model.SuccessMessage
        </div>
    }

    <form method="post">
        <!-- Email Field -->
        <div class="input-group-custom">
            <label class="input-label-custom" asp-for="Input.Email">Email Address</label>
            <div class="input-pill-wrapper">
                <i class="bi bi-envelope input-pill-icon"></i>
                <input asp-for="Input.Email" class="form-control-pill" id="loginEmail" autocomplete="email" />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block text-start"></span>
        </div>

        <!-- Password Field -->
        <div class="input-group-custom">
            <div class="input-label-custom">
                <span>Password</span>
                <a href="javascript:void(0)" class="text-decoration-none small text-muted">Forgot</a>
            </div>
            <div class="input-pill-wrapper">
                <i class="bi bi-lock input-pill-icon"></i>
                <input asp-for="Input.Password" type="password" id="loginPassword" class="form-control-pill" autocomplete="current-password" />
                <button type="button" class="input-pill-suffix" onclick="togglePasswordVisibility('loginPassword', 'eyeIcon')">
                    <i class="bi bi-eye" id="eyeIcon"></i>
                </button>
            </div>
            <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block text-start"></span>
        </div>

        <!-- SECRET-CODE Field (User specified requirement) -->
        <div class="input-group-custom">
            <div class="input-label-custom">
                <span class="text-warning fw-bold"><i class="bi bi-shield-lock-fill me-1"></i>SECRET-CODE:</span>
                <span class="badge bg-secondary-subtle text-muted" style="font-size: 0.7rem;">Optional</span>
            </div>
            <div class="input-pill-wrapper">
                <i class="bi bi-key-fill input-pill-icon text-warning"></i>
                <input asp-for="Input.SecretCode" id="loginSecret" class="form-control-pill border-warning-subtle" />
            </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn-auth-primary">
            <span>Sign In</span>
            <i class="bi bi-arrow-right"></i>
        </button>

        <!-- Link to Register -->
        <div class="auth-footer-link">
            Don't have an account? <a asp-page="/Account/Register">Sign up</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
