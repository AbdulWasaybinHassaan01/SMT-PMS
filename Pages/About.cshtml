@page
@model TechWorldPMS.Pages.AboutModel
@{
    ViewData["Title"] = "About & Architecture";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <i class="bi bi-info-circle text-primary fs-3"></i>
    <h2 class="fw-bold mb-0 text-dark">System Architecture & Overview</h2>
</div>

<!-- Wireframes Overview (From Image 2) -->
<div class="custom-card p-4 mb-4">
    <h5 class="fw-bold text-dark mb-3">
        <i class="bi bi-layout-text-window-reverse text-primary me-2"></i>Wireframes (Simple Layouts)
    </h5>
    <div class="row g-3 text-center">
        <div class="col-6 col-md">
            <div class="p-3 border rounded-3 bg-light h-100">
                <i class="bi bi-speedometer2 text-primary fs-2 mb-2 d-block"></i>
                <div class="fw-bold small text-dark">Dashboard</div>
                <div class="text-muted" style="font-size: 0.75rem;">Metrics & Recent Products</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="p-3 border rounded-3 bg-light h-100">
                <i class="bi bi-table text-primary fs-2 mb-2 d-block"></i>
                <div class="fw-bold small text-dark">Product List</div>
                <div class="text-muted" style="font-size: 0.75rem;">Search, Filter & Manage</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="p-3 border rounded-3 bg-light h-100">
                <i class="bi bi-ui-checks text-primary fs-2 mb-2 d-block"></i>
                <div class="fw-bold small text-dark">Add / Edit Form</div>
                <div class="text-muted" style="font-size: 0.75rem;">Validation & Image Upload</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="p-3 border rounded-3 bg-light h-100">
                <i class="bi bi-card-text text-primary fs-2 mb-2 d-block"></i>
                <div class="fw-bold small text-dark">Product Details</div>
                <div class="text-muted" style="font-size: 0.75rem;">Read-only Specification</div>
            </div>
        </div>
        <div class="col-6 col-md">
            <div class="p-3 border rounded-3 bg-light h-100">
                <i class="bi bi-exclamation-triangle text-danger fs-2 mb-2 d-block"></i>
                <div class="fw-bold small text-dark">Delete Confirmation</div>
                <div class="text-muted" style="font-size: 0.75rem;">Safe Guarded Removal</div>
            </div>
        </div>
    </div>
</div>

<!-- Project Architecture, Key Features & Tech Stack (From Image 2) -->
<div class="row g-4">
    <!-- Project Architecture -->
    <div class="col-lg-5">
        <div class="custom-card p-4 h-100">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-diagram-3-fill text-primary me-2"></i>Project Architecture
            </h5>
            <div class="d-flex flex-column gap-3 text-center">
                <div class="p-3 rounded-3 bg-primary-subtle border border-primary text-primary fw-bold">
                    <div>Razor Pages (UI Layer)</div>
                    <div class="small fw-normal text-muted">Dashboard, Products, Forms, Customer Store</div>
                </div>
                <div class="text-muted"><i class="bi bi-arrow-down fs-4"></i></div>
                <div class="p-3 rounded-3 bg-light border fw-bold text-dark">
                    <div>IRepositories</div>
                    <div class="small fw-normal text-muted">Repository Pattern Abstraction</div>
                </div>
                <div class="text-muted"><i class="bi bi-arrow-down fs-4"></i></div>
                <div class="p-3 rounded-3 bg-light border fw-bold text-dark">
                    <div>Concrete Repositories</div>
                    <div class="small fw-normal text-muted">ADO.NET + Parameterized SQL Queries & Transactions</div>
                </div>
                <div class="text-muted"><i class="bi bi-arrow-down fs-4"></i></div>
                <div class="p-3 rounded-3 bg-dark text-white rounded-3 shadow-sm fw-bold">
                    <div><i class="bi bi-database me-2 text-info"></i>Microsoft SQL Server Database</div>
                    <div class="small fw-normal text-light opacity-75">TechWorldPMS (Tables: Products, Categories, Users, Cart, Orders)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Key Features -->
    <div class="col-lg-4">
        <div class="custom-card p-4 h-100">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-check2-all text-success me-2"></i>Key Features
            </h5>
            <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <span class="fw-semibold">Add, Edit, View & Delete Products</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <span class="fw-semibold">Search & Filter Products</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <span class="fw-semibold">Category Management</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <span class="fw-semibold">Input Validation & Feedback</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <span class="fw-semibold">Clean Repository Architecture</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <span class="fw-semibold">Responsive & Fast Design</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <span class="fw-semibold">Easy to Extend & Maintain</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <span class="fw-semibold">Secret-Code Admin Access (ANYONEUSEIT)</span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <span class="fw-semibold">Customer Cart, Checkout & Profile Address</span>
                </li>
            </ul>
        </div>
    </div>

    <!-- Tech Stack -->
    <div class="col-lg-3">
        <div class="custom-card p-4 h-100">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-layers-fill text-primary me-2"></i>Tech Stack
            </h5>
            <div class="d-flex flex-column gap-3">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <div class="badge bg-purple p-2 fs-5" style="background-color: #6366f1;"><i class="bi bi-code-slash text-white"></i></div>
                    <div>
                        <div class="fw-bold text-dark">ASP.NET Core</div>
                        <div class="small text-muted">Razor Pages 8.0</div>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <div class="badge p-2 fs-5" style="background-color: #9333ea;"><i class="bi bi-file-earmark-code text-white"></i></div>
                    <div>
                        <div class="fw-bold text-dark">C#</div>
                        <div class="small text-muted">Modern C# 12</div>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <div class="badge p-2 fs-5" style="background-color: #0284c7;"><i class="bi bi-database text-white"></i></div>
                    <div>
                        <div class="fw-bold text-dark">SQL Server</div>
                        <div class="small text-muted">Relational Database</div>
                    </div>
                </div>

                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <div class="badge p-2 fs-5" style="background-color: #0d9488;"><i class="bi bi-plug text-white"></i></div>
                    <div>
                        <div class="fw-bold text-dark">ADO.NET</div>
                        <div class="small text-muted">Clean Data Access</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

