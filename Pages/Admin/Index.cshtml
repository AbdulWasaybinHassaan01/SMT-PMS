@page
@model TechWorldPMS.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-speedometer2 fs-3 text-primary"></i>
        <h2 class="fw-bold mb-0 text-dark">Dashboard</h2>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Products/Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Add New Product</span>
        </a>
    </div>
</div>

<!-- 4 Stats Cards (From Image 2) -->
<div class="row g-3 mb-4">
    <!-- Total Products -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon primary">
                <i class="bi bi-box-seam"></i>
            </div>
            <div>
                <div class="stat-label">Total Products</div>
                <div class="stat-value">@Model.Stats.TotalProducts</div>
            </div>
        </div>
    </div>

    <!-- Total Categories -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon success">
                <i class="bi bi-tags"></i>
            </div>
            <div>
                <div class="stat-label">Total Categories</div>
                <div class="stat-value">@Model.Stats.TotalCategories</div>
            </div>
        </div>
    </div>

    <!-- In Stock -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon warning">
                <i class="bi bi-archive"></i>
            </div>
            <div>
                <div class="stat-label">In Stock</div>
                <div class="stat-value">@Model.Stats.InStockCount</div>
            </div>
        </div>
    </div>

    <!-- Low Stock -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-icon danger">
                <i class="bi bi-exclamation-triangle"></i>
            </div>
            <div>
                <div class="stat-label">Low Stock</div>
                <div class="stat-value text-danger">@Model.Stats.LowStockCount</div>
            </div>
        </div>
    </div>
</div>

<!-- TechWORLD Hero Promo Banner (From Image 2) -->
<div class="hero-promo-card">
    <div class="row align-items-center">
        <div class="col-md-7 mb-3 mb-md-0">
            <h1 class="display-6 fw-extrabold mb-1" style="color: #38bdf8; letter-spacing: 0.5px;">TechWORLD</h1>
            <h4 class="fw-semibold text-white mb-2">Your One-Stop Tech Store</h4>
            <p class="text-light opacity-75 mb-0" style="font-size: 0.95rem;">
                Computers &middot; Laptops &middot; Accessories &middot; Components &middot; Monitors
            </p>
        </div>
        <div class="col-md-5 text-center text-md-end">
            <img src="~/images/banner/banner-laptop.png" alt="TechWORLD Featured Laptop" class="hero-laptop-img" />
        </div>
    </div>
</div>

<!-- Recent Products Section (From Image 2) -->
<div class="custom-card">
    <div class="custom-card-header">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-clock-history text-primary fs-5"></i>
            <h5 class="fw-bold mb-0 text-dark">Recent Products</h5>
        </div>
        <a asp-page="/Products/Index" class="text-primary text-decoration-none fw-semibold small d-flex align-items-center gap-1">
            <span>View All</span>
            <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th style="width: 80px;">Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price (PKR)</th>
                    <th>Stock</th>
                    <th class="text-center" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int index = 1; }
                @foreach (var p in Model.RecentProducts)
                {
                    string catClass = "badge-cat-primary";
                    if (p.CategoryName == "Accessories") catClass = "badge-cat-purple";
                    else if (p.CategoryName == "Monitors") catClass = "badge-cat-success";
                    else if (p.CategoryName == "Gaming") catClass = "badge-cat-danger";
                    else if (p.CategoryName == "Audio") catClass = "badge-cat-warning";
                    else if (p.CategoryName == "Components") catClass = "badge-cat-info";

                    string stockClass = p.StockQuantity > 5 ? "badge-stock-in" : (p.StockQuantity > 0 ? "badge-stock-low" : "badge-stock-out");

                    <tr>
                        <td class="text-muted fw-bold">@(index++)</td>
                        <td>
                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/products/default-product.svg" : p.ImageUrl)" 
                                 alt="@p.Name" 
                                 class="product-table-thumb" 
                                 onerror="this.onerror=null; this.src='/images/products/default-product.svg'" />
                        </td>
                        <td class="fw-semibold text-dark">@p.Name</td>
                        <td>
                            <span class="badge badge-category @catClass">@p.CategoryName</span>
                        </td>
                        <td class="fw-bold text-dark">@p.Price.ToString("N0")</td>
                        <td>
                            <span class="badge @stockClass badge-stock">@p.StockQuantity</span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-center gap-1">
                                <a asp-page="/Products/Details" asp-route-id="@p.ProductId" class="btn-action-view" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="/Products/Edit" asp-route-id="@p.ProductId" class="btn-action-edit" title="Edit Product">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="/Products/Delete" asp-route-id="@p.ProductId" class="btn-action-delete" title="Delete Product">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.RecentProducts.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No products found in the database.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


