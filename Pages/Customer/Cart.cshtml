@page
@model TechWorldPMS.Pages.Customer.CartModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-cart3 fs-3 text-primary"></i>
        <h2 class="fw-bold mb-0 text-dark">Shopping Cart</h2>
    </div>
    @if (Model.CartItems.Any())
    {
        <form method="post" asp-page-handler="ClearCart" onsubmit="return confirm('Empty your cart?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash me-1"></i> Clear Cart
            </button>
        </form>
    }
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.CartItems.Any())
{
    <div class="row g-4">
        <!-- Cart Items Table -->
        <div class="col-lg-8">
            <div class="custom-card">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;">Item</th>
                                <th>Product Details</th>
                                <th>Unit Price</th>
                                <th style="width: 140px;">Quantity</th>
                                <th>Subtotal</th>
                                <th style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/products/default-product.svg" : item.ImageUrl)" 
                                             alt="@item.ProductName" 
                                             class="rounded border p-1" 
                                             style="width: 56px; height: 56px; object-fit: contain; background: #0f172a;" 
                                             onerror="this.onerror=null; this.src='/images/products/default-product.svg'" />
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.ProductName</div>
                                        <span class="badge bg-primary-subtle text-primary small">@item.CategoryName</span>
                                    </td>
                                    <td class="fw-semibold text-secondary">PKR @item.Price.ToString("N0")</td>
                                    <td>
                                        <div class="qty-control">
                                            <form method="post" asp-page-handler="UpdateQuantity" class="d-inline">
                                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                                <button type="submit" class="qty-btn" title="Decrease">&minus;</button>
                                            </form>
                                            <span class="qty-input d-flex align-items-center justify-content-center">@item.Quantity</span>
                                            <form method="post" asp-page-handler="UpdateQuantity" class="d-inline">
                                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                                <button type="submit" class="qty-btn" title="Increase" @(item.Quantity >= item.AvailableStock ? "disabled" : "")>&plus;</button>
                                            </form>
                                        </div>
                                        @if (item.AvailableStock <= 5)
                                        {
                                            <div class="text-danger small mt-1" style="font-size: 0.72rem;">Only @item.AvailableStock in stock</div>
                                        }
                                    </td>
                                    <td class="fw-bold text-primary">PKR @item.SubTotal.ToString("N0")</td>
                                    <td>
                                        <form method="post" asp-page-handler="RemoveItem">
                                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                            <button type="submit" class="btn btn-sm text-danger" title="Remove item">
                                                <i class="bi bi-x-circle fs-5"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="mt-3">
                <a asp-page="/Customer/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                </a>
            </div>
        </div>

        <!-- Order Summary Card -->
        <div class="col-lg-4">
            <div class="custom-card p-4">
                <h5 class="fw-bold text-dark mb-3">Order Summary</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">Items Subtotal</span>
                    <span class="fw-semibold">PKR @Model.TotalAmount.ToString("N0")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">Doorstep Shipping</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-4">
                    <span class="fs-5 fw-bold text-dark">Total Amount</span>
                    <span class="fs-4 fw-extrabold text-primary">PKR @Model.TotalAmount.ToString("N0")</span>
                </div>

                <a asp-page="/Customer/Checkout" class="btn btn-primary btn-lg w-100 d-flex align-items-center justify-content-center gap-2 py-3 shadow">
                    <span>Proceed to Checkout</span>
                    <i class="bi bi-arrow-right"></i>
                </a>

                <div class="mt-3 text-center text-muted small">
                    <i class="bi bi-shield-lock-fill text-success me-1"></i> Safe & Secure Checkout Guarantee
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="custom-card p-5 text-center my-4">
        <i class="bi bi-cart-x fs-1 text-muted d-block mb-3"></i>
        <h4 class="fw-bold text-dark">Your cart is currently empty</h4>
        <p class="text-secondary">Looks like you haven't added any products to your cart yet.</p>
        <a asp-page="/Customer/Index" class="btn btn-primary px-4 mt-2">
            <i class="bi bi-bag me-1"></i> Start Shopping Now
        </a>
    </div>
}


