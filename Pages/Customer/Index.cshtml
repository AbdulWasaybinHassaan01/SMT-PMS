@page
@model TechWorldPMS.Pages.Customer.IndexModel
@{
    ViewData["Title"] = "Tech Store";
}

<!-- Customer Hero Section -->
<div class="hero-promo-card mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #2563eb 100%);">
    <div class="row align-items-center">
        <div class="col-md-8">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">
                <i class="bi bi-stars me-1"></i> Customer Exclusive Deals
            </span>
            <h1 class="display-6 fw-bold text-white mb-2">Welcome to TechWORLD Store</h1>
            <p class="text-light opacity-75 mb-3" style="max-width: 600px;">
                Explore high-performance laptops, pro gaming peripherals, crisp 4K monitors, and custom PC components with official warranty.
            </p>
            <div class="d-flex gap-3 text-light small">
                <span><i class="bi bi-truck text-warning me-1"></i> Fast Doorstep Delivery</span>
                <span><i class="bi bi-shield-check text-warning me-1"></i> 100% Genuine Products</span>
                <span><i class="bi bi-cash-stack text-warning me-1"></i> Cash on Delivery Available</span>
            </div>
        </div>
        <div class="col-md-4 text-center text-md-end d-none d-md-block">
            <img src="~/images/banner/banner-laptop.png" alt="Laptop" class="hero-laptop-img" />
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <a asp-page="/Customer/Cart" class="alert-link ms-2 fw-bold">View Cart & Checkout &rarr;</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Categories Bar -->
<div class="custom-card p-3 mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-lg-5">
            <form method="get" class="d-flex">
                <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input asp-for="SearchTerm" class="form-control border-start-0" placeholder="Search laptops, headphones, monitors..." />
                    <button class="btn btn-primary" type="submit">Search</button>
                </div>
            </form>
        </div>
        <div class="col-lg-7">
            <div class="d-flex gap-2 overflow-auto pb-1">
                <a asp-page="/Customer/Index" asp-route-searchTerm="@Model.SearchTerm" class="category-pill-btn @(!Model.CategoryId.HasValue ? "active" : "")">
                    All Products
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-page="/Customer/Index" asp-route-categoryId="@cat.CategoryId" asp-route-searchTerm="@Model.SearchTerm" class="category-pill-btn @(Model.CategoryId == cat.CategoryId ? "active" : "")">
                        @cat.CategoryName
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Products Grid -->
<div class="row g-4">
    @foreach (var p in Model.Products)
    {
        string catBadge = "badge-cat-primary";
        if (p.CategoryName == "Accessories") catBadge = "badge-cat-purple";
        else if (p.CategoryName == "Monitors") catBadge = "badge-cat-success";
        else if (p.CategoryName == "Gaming") catBadge = "badge-cat-danger";
        else if (p.CategoryName == "Audio") catBadge = "badge-cat-warning";
        else if (p.CategoryName == "Components") catBadge = "badge-cat-info";

        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="customer-product-card">
                <!-- Product Image -->
                <div class="customer-product-img-wrap">
                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/products/default-product.svg" : p.ImageUrl)" 
                         alt="@p.Name" 
                         class="customer-product-img" 
                         onerror="this.onerror=null; this.src='/images/products/default-product.svg'" />
                    <span class="badge @catBadge badge-category position-absolute top-0 start-0 m-3">
                        @p.CategoryName
                    </span>
                </div>

                <!-- Product Content -->
                <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <span class="small @(p.StockQuantity > 5 ? "text-success" : (p.StockQuantity > 0 ? "text-warning" : "text-danger")) fw-bold">
                                @if (p.StockQuantity > 5) { <text><i class="bi bi-check2"></i> In Stock (@p.StockQuantity)</text> }
                                else if (p.StockQuantity > 0) { <text><i class="bi bi-clock-history"></i> Low Stock (@p.StockQuantity left)</text> }
                                else { <text><i class="bi bi-x-circle"></i> Out of Stock</text> }
                            </span>
                        </div>
                        <h6 class="fw-bold text-dark text-truncate mb-1" title="@p.Name">@p.Name</h6>
                        <p class="text-secondary small text-truncate-2 mb-3" style="font-size: 0.825rem; min-height: 38px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @p.Description
                        </p>
                    </div>

                    <div class="pt-2 border-top">
                        <div class="d-flex align-items-baseline justify-content-between mb-2">
                            <span class="text-muted small">Price</span>
                            <span class="fw-extrabold fs-5 text-primary">Rs. @p.Price.ToString("N0")</span>
                        </div>

                        <!-- Add to Cart Form with Quantity Selector -->
                        <form method="post" asp-page-handler="AddToCart" class="d-flex flex-column gap-2">
                            <input type="hidden" name="productId" value="@p.ProductId" />
                            <div class="d-flex gap-2 align-items-center">
                                <div class="qty-control flex-grow-0">
                                    <button type="button" class="qty-btn" onclick="decreaseQty('qty-@p.ProductId')">&minus;</button>
                                    <input type="number" id="qty-@p.ProductId" name="quantity" class="qty-input" value="1" min="1" max="@Math.Max(1, p.StockQuantity)" />
                                    <button type="button" class="qty-btn" onclick="increaseQty('qty-@p.ProductId', @p.StockQuantity)">&plus;</button>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm flex-grow-1 d-flex align-items-center justify-content-center gap-1 py-2" @(p.StockQuantity <= 0 ? "disabled" : "")>
                                    <i class="bi bi-cart-plus"></i>
                                    <span>Add to Cart</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (!Model.Products.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="custom-card p-5">
                <i class="bi bi-emoji-neutral fs-1 text-muted d-block mb-3"></i>
                <h4 class="fw-bold">No products found</h4>
                <p class="text-secondary">Try searching for something else or clear the filters.</p>
                <a asp-page="/Customer/Index" class="btn btn-primary px-4 mt-2">View All Products</a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function decreaseQty(id) {
            const input = document.getElementById(id);
            let val = parseInt(input.value) || 1;
            if (val > 1) {
                input.value = val - 1;
            }
        }

        function increaseQty(id, maxStock) {
            const input = document.getElementById(id);
            let val = parseInt(input.value) || 1;
            if (val < maxStock) {
                input.value = val + 1;
            }
        }
    </script>
}


