@page "{id:int}"
@model TechWorldPMS.Pages.Products.EditModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <i class="bi bi-pencil-square text-primary fs-3"></i>
    <h2 class="fw-bold mb-0 text-dark">Edit Product</h2>
</div>

<div class="custom-card p-4">
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Input.ProductId" />
        <input type="hidden" asp-for="Input.CurrentImageUrl" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small mb-3"></div>

        <div class="row g-4">
            <!-- Left: Current Image & Change Image Button (From Image 2) -->
            <div class="col-md-4 col-lg-3 text-center">
                <div class="p-3 rounded-3 bg-dark d-flex align-items-center justify-content-center mb-3" style="min-height: 180px;">
                    <img id="currentImagePreview" 
                         src="@(string.IsNullOrEmpty(Model.Input.CurrentImageUrl) ? "/images/products/default-product.svg" : Model.Input.CurrentImageUrl)" 
                         alt="@Model.Input.Name" 
                         class="img-fluid rounded" 
                         style="max-height: 150px; object-fit: contain;" 
                         onerror="this.onerror=null; this.src='/images/products/default-product.svg'" />
                </div>
                <div>
                    <label for="newImageFile" class="btn btn-outline-secondary btn-sm px-3 w-100">
                        <i class="bi bi-camera me-1"></i> Change Image
                    </label>
                    <input asp-for="NewProductImageFile" type="file" id="newImageFile" class="d-none" accept="image/*" onchange="previewEditImage(event)" />
                    <div id="newFileName" class="text-muted small mt-1 text-truncate"></div>
                </div>
            </div>

            <!-- Right: Product Fields (From Image 2) -->
            <div class="col-md-8 col-lg-9">
                <div class="row g-3">
                    <!-- Product Name -->
                    <div class="col-md-6">
                        <label class="form-label-custom" asp-for="Input.Name">
                            Product Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Name" class="form-control form-control-custom" />
                        <span asp-validation-for="Input.Name" class="text-danger small"></span>
                    </div>

                    <!-- Category -->
                    <div class="col-md-6">
                        <label class="form-label-custom" asp-for="Input.CategoryId">
                            Category <span class="text-danger">*</span>
                        </label>
                        <select asp-for="Input.CategoryId" asp-items="Model.CategoryOptions" class="form-select form-select-custom"></select>
                        <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Price (PKR) -->
                    <div class="col-md-6">
                        <label class="form-label-custom" asp-for="Input.Price">
                            Price (PKR) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Price" type="number" step="0.01" class="form-control form-control-custom" />
                        <span asp-validation-for="Input.Price" class="text-danger small"></span>
                    </div>

                    <!-- Stock Quantity -->
                    <div class="col-md-6">
                        <label class="form-label-custom" asp-for="Input.StockQuantity">
                            Stock Quantity <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.StockQuantity" type="number" class="form-control form-control-custom" />
                        <span asp-validation-for="Input.StockQuantity" class="text-danger small"></span>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label-custom" asp-for="Input.Description">Description</label>
                        <textarea asp-for="Input.Description" rows="4" class="form-control form-control-custom"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Action Buttons (From Image 2) -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-page="/Products/Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary d-flex align-items-center gap-2 px-4">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>Update Product</span>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewEditImage(event) {
            const input = event.target;
            const preview = document.getElementById('currentImagePreview');
            const fileNameDiv = document.getElementById('newFileName');
            if (input.files && input.files[0]) {
                fileNameDiv.textContent = input.files[0].name;
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}


