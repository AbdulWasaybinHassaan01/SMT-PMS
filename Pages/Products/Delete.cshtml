@page "{id:int}"
@model TechWorldPMS.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Delete Product";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <i class="bi bi-trash3 text-danger fs-3"></i>
    <h2 class="fw-bold mb-0 text-dark">Delete Product</h2>
</div>

<div class="custom-card p-4 mx-auto" style="max-width: 650px;">
    <!-- Warning Box (From Image 2) -->
    <div class="delete-warning-box mb-4">
        <i class="bi bi-exclamation-circle-fill delete-warning-icon"></i>
        <h3 class="fw-bold text-dark mb-1">Are you sure?</h3>
        <p class="text-secondary mb-3">You are about to delete this product:</p>

        <div class="d-flex align-items-center justify-content-center gap-3 p-3 bg-white rounded-3 border mb-3">
            <img src="@(string.IsNullOrEmpty(Model.Product.ImageUrl) ? "/images/products/default-product.svg" : Model.Product.ImageUrl)" 
                 alt="@Model.Product.Name" 
                 class="product-table-thumb" 
                 onerror="this.onerror=null; this.src='/images/products/default-product.svg'" />
            <div class="text-start">
                <div class="fw-bold text-dark fs-5">@Model.Product.Name</div>
                <div class="text-primary fw-semibold">Rs. @Model.Product.Price.ToString("N0")</div>
            </div>
        </div>

        <p class="text-danger small fw-semibold mb-0">
            <i class="bi bi-info-circle me-1"></i> This action cannot be undone.
        </p>
    </div>

    <!-- Action Buttons (From Image 2) -->
    <form method="post" class="d-flex justify-content-end gap-2">
        <a asp-page="/Products/Index" class="btn btn-outline-secondary px-4">Cancel</a>
        <button type="submit" class="btn btn-danger d-flex align-items-center gap-2 px-4">
            <i class="bi bi-trash-fill"></i>
            <span>Delete</span>
        </button>
    </form>
</div>


