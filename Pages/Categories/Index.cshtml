@page
@model TechWorldPMS.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center gap-2">
        <i class="bi bi-grid-3x3-gap fs-3 text-primary"></i>
        <div>
            <h2 class="fw-bold mb-0 text-dark">Categories</h2>
            <div class="text-muted small">Manage product classifications and catalog groups</div>
        </div>
    </div>
    <button type="button" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
        <i class="bi bi-plus-circle-fill"></i>
        <span>Add Category</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Categories Grid -->
<div class="row g-4 mb-4">
    @foreach (var cat in Model.Categories)
    {
        string badgeClass = "badge-cat-primary";
        if (cat.CategoryName == "Accessories") badgeClass = "badge-cat-purple";
        else if (cat.CategoryName == "Monitors") badgeClass = "badge-cat-success";
        else if (cat.CategoryName == "Gaming") badgeClass = "badge-cat-danger";
        else if (cat.CategoryName == "Audio") badgeClass = "badge-cat-warning";
        else if (cat.CategoryName == "Components") badgeClass = "badge-cat-info";

        <div class="col-md-6 col-lg-4">
            <div class="custom-card p-4 h-100 d-flex flex-direction-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge badge-category @badgeClass">@cat.CategoryName</span>
                        <span class="badge bg-light text-dark border">@cat.ProductCount Products</span>
                    </div>
                    <p class="text-secondary small mt-2 mb-3">
                        @(string.IsNullOrEmpty(cat.Description) ? "No category description provided." : cat.Description)
                    </p>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                    <a asp-page="/Products/Index" asp-route-categoryId="@cat.CategoryId" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-eye me-1"></i> View Products
                    </a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@cat.CategoryId" onsubmit="return confirm('Are you sure you want to delete this category? Associated products may be affected.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Category">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="addCategoryModalLabel">
                    <i class="bi bi-plus-circle-fill text-primary me-2"></i>Add New Category
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="Add">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label-custom" asp-for="NewCategory.CategoryName">
                            Category Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="NewCategory.CategoryName" class="form-control form-control-custom" placeholder="e.g. Smartwatches" required />
                        <span asp-validation-for="NewCategory.CategoryName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-custom" asp-for="NewCategory.Description">Description</label>
                        <textarea asp-for="NewCategory.Description" rows="3" class="form-control form-control-custom" placeholder="Category description..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label-custom" asp-for="NewCategory.ColorBadge">Badge Theme</label>
                        <select asp-for="NewCategory.ColorBadge" class="form-select form-select-custom">
                            <option value="primary">Blue (Primary)</option>
                            <option value="purple">Purple (Accessories)</option>
                            <option value="success">Green (Monitors)</option>
                            <option value="danger">Red (Gaming)</option>
                            <option value="warning">Orange (Audio)</option>
                            <option value="info">Cyan (Components)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

