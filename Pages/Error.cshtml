@page
@model TechWorldPMS.Pages.ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="custom-card p-5 mx-auto" style="max-width: 500px;">
        <i class="bi bi-exclamation-octagon-fill text-danger fs-1 mb-3"></i>
        <h2 class="fw-bold text-dark">Something went wrong</h2>
        <p class="text-secondary">An error occurred while processing your request.</p>
        <a asp-page="/Index" class="btn btn-primary px-4 mt-2">Return to Home</a>
    </div>
</div>

